				<string>import os
import json
import sys

data_folder = os.environ['alfred_workflow_data']

previous_file = os.path.join(data_folder, 'previous')

if os.path.exists(previous_file):
    with open(previous_file, 'r') as f:
        previous_lines = f.read().split('\n')
        print(previous_lines, file=sys.stderr)
        title = previous_lines[0].replace('Uplink capacity:', '↑')
        title += ' | '
        title += previous_lines[1].replace('Downlink capacity:', '↓')
        subtitle = previous_lines[2]
        subtitle += ' / ' + previous_lines[3].replace('Idle ', '')
        subtitle = subtitle.replace('milliseconds', 'ms')
        
        print(json.dumps({'items': [{'title': title, 'subtitle': subtitle}]}))
else:
    print(json.dumps({'items': [{'title':'No saved previous network quality test.'}]}))</string>
